#List of months
months = [
    "January",
    "February",
    "March",
    "April",
    "May",
    "June",
    "July",
    "August",
    "September",
    "October",
    "November",
    "December"
]

while True:
    date = input("Date: ")

    try:
        if "/" in date: #If formatted in MM/DD/YY
            month, day, year = date.split("/")

            month = int(month)
            day = int(day)
            year = int(year)

            if 1 <= month <= 12 and 1 <= day <= 31:
                print(f"{year:04}-{month:02}-{day:02}")
                break

        elif "," in date: #If formatted in Month DD, YY
            month, day, year = date.split(" ")

            day = int(day.strip(","))
            year = int(year)

            if month in months and 1 <= day <= 31:
                month = months.index(month) + 1
                print(f"{year:04}-{month:02}-{day:02}")
                break

    except ValueError:
        pass
