grocery = {} #Initial empty list

while True: #Condition given to prompt the user repeatedly
    try:
        item = input("What your item? ").lower()
    except EOFError:
        print()
        break

    if item in grocery: #If the inputted item is in the list, add 1 on the right
        grocery[item] += 1
    else: #If the inputted item isn't in the list, just have 1 on the right
        grocery[item] = 1

for item in sorted(grocery): #Sorting the list in alphabitical order
    print(grocery[item], item.upper()) #Making the items upper case


