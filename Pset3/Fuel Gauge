while True:
    try:
        x, y = map(int, input("Enter a fraction: ").split('/'))
        if x < 0 or y <= 0:
            raise ValueError()
        if x > y:
            raise ValueError()
        break
    except ValueError:
        print("Invalid input. Please enter a valid fraction.")


z = x / y
if z < 0.01:
    print("E")
elif z > 0.99:
    print("F")
else:
    print(f"Fuel level entered: {int(z*100)}%")



